# Leave empty when the client is served by the Node server (same domain).
# Set to the API address only if frontend and backend are on different domains.
VITE_API_URL=

# Optional: another map tile provider (default is free OpenStreetMap)
# e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTR=
