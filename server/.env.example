PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Which providers to query, in order. "local" = your own database (data/shipments.json demo).
# Add carriers you have API keys for, comma separated: local,shiprocket,delhivery,aftership
PROVIDERS=local

# --- Shiprocket (https://apidocs.shiprocket.in) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Delhivery (https://one.delhivery.com/developer-portal) ---
DELHIVERY_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com

# --- AfterShip (multi-carrier, https://www.aftership.com/docs/tracking) ---
AFTERSHIP_API_KEY=

# Geocoding for scan locations that come without coordinates.
# "nominatim" (free OpenStreetMap, 1 req/sec) or "google" (needs key)
GEOCODER=nominatim
GOOGLE_MAPS_API_KEY=
GEOCODER_USER_AGENT=parcel-tracker/1.0 (your-email@example.com)
