PORT=5000
# Extra sites allowed to call the API from a browser (the live domain is always allowed)
CLIENT_ORIGIN=http://localhost:5173
# Proxies in front of the app (GoDaddy = 1). Open /api/health: "yourIp" must be your real IP.
TRUST_PROXY=1
# Security reports contact (shown in /.well-known/security.txt)
SECURITY_CONTACT=info@trackmyship.co
# true = Content-Security-Policy only reports problems instead of blocking (for troubleshooting)
CSP_REPORT_ONLY=
# Public address of the site (used in canonical links, sitemap.xml, social previews)
SITE_URL=https://trackmyship.co
# AI model-training crawlers (GPTBot, Google-Extended, CCBot, ClaudeBot): leave empty to allow,
# or set to "block" to disallow them in robots.txt. Search crawlers (incl. OAI-SearchBot) stay allowed.
AI_TRAINING_CRAWLERS=

# Which providers to query, in order. "local" = your own database (data/shipments.json demo).
# Add carriers you have API keys for, comma separated: local,shiprocket,delhivery,trackcourier
PROVIDERS=local,trackcourier
# Demo shipments (TMS100245781 etc.) for local testing only. Keep empty/false on the live site.
DEMO_SHIPMENTS=

# --- Shiprocket (https://apidocs.shiprocket.in) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Delhivery (https://one.delhivery.com/developer-portal) ---
DELHIVERY_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com

# --- TrackCourier.io (DTDC, Blue Dart, Delhivery, Speed Post, Trackon, Professional... https://api.trackcourier.io/docs) ---
# Free plan: 100 requests/month, 10/minute. Key from the TrackCourier.io API dashboard.
TRACKCOURIER_API_KEY=
# Reuse a live result for this many minutes before asking the API again (saves quota)
TRACKCOURIER_CACHE_MINUTES=30

# Geocoding for scan locations that come without coordinates.
# "nominatim" (free OpenStreetMap, 1 req/sec) or "google" (needs key)
GEOCODER=nominatim
GOOGLE_MAPS_API_KEY=
GEOCODER_USER_AGENT=track-my-ship/1.0 (info@trackmyship.co)
